{
  "$schema": "https://json.schemastore.org/swcrc",
  "exclude": "node_modules/",
  "sourceMaps": true,
  "isModule": true,
  "module": {
    "type": "nodenext",
    "resolveFully": true
  },
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true,
      "dts": true,
      "tsx": true
    },
    "target": "esnext",
    "baseUrl": "./",
    "experimental": {
      "plugins": [
        [
          "@swc/plugin-transform-imports",
          {
            "^(.*?)(\\.ts(x)?)$": {
              "skipDefaultConversion": true,
              "transform": "{{matches.[1]}}.js"
            }
          }
        ]
      ]
    }
  }
}
